# Kopieren nach .env.local und Werte eintragen. Keine Werte in dieses Repository!

# WordPress (Headless-Hub) – nur hier, nirgends fest im Code
KLS_WP_URL=
KLS_SITE=

# Secrets (dieselben Werte wie in der wp-config.php von WordPress)
KLS_API_KEY=
KLS_REVALIDATE_SECRET=
KLS_PREVIEW_SECRET=

# Endgültige Domain des Frontends (Canonical, Sitemap, Open Graph)
SITE_URL=
# true = Suchmaschinen erlaubt; alles andere (Standard) = noindex, nofollow, robots.txt sperrt alles
SITE_INDEXABLE=

# Matomo (optional, beide leer = kein Tracking-Code)
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=
